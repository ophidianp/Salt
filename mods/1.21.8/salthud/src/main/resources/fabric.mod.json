{
  "schemaVersion": 1,
  "id": "salthud",
  "version": "${version}",
  "name": "saltHUD",
  "description": "The saltClient HUD: FPS, CPS, ping, coordinates, keystrokes, armor, potions, clock, speed and more. Edit it in the launcher or press Right Shift in game.",
  "authors": [
    "saltClient"
  ],
  "license": "MIT",
  "icon": "assets/salthud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "gg.salt.hud.SaltHud"
    ]
  },
  "mixins": [
    "salthud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": ">=1.21.6 <1.21.9",
    "java": ">=21",
    "fabric-api": "*",
    "saltconfig": "*"
  }
}
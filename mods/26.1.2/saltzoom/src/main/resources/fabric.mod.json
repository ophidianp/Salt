  "entrypoints": {
    "client": [
      "gg.salt.zoom.SaltZoom"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*",
    "saltconfig": "*"
  },
  "mixins": [
    "saltzoom.mixins.json"
  ]
}
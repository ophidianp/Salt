{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "saltClient",
  "version": "0.1.0",
  "identifier": "gg.salt.launcher",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "saltClient",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#0b0f17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://cdn.modrinth.com https://media.forgecdn.net https://textures.minecraft.net; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../dist/salt-mods/": "salt-mods/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "saltClient",
    "longDescription": "A clean, glassy Minecraft launcher with saltHUD, performance mods, Modrinth and CurseForge.",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
